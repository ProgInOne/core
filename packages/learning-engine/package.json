{
  "name": "@proginone/learning-engine",
  "version": "0.2.0",
  "description": "숙련도·FSRS·연습 세트 구성을 계산하는 순수 함수 학습 엔진",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProgInOne/core.git",
    "directory": "packages/learning-engine"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
