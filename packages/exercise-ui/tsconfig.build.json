{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Built output must reference published packages, not their sources.
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"]
}
